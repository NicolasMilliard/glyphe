{
  "name": "glyphe-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/www && bun run dev",
    "build": "cd apps/www && bun run build",
    "format": "prettier --write .",
    "lint": "cd apps/www && bun run lint && cd ../../packages/glyphe && bun run lint",
    "preview": "cd apps/www && bun run preview",
    "test": "cd apps/www && bun run test",
    "check": "bun run lint && bun run test && bun run build",
    "package:build": "cd packages/glyphe && bun run build"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.2"
  }
}
